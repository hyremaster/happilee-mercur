# Private @happilee-app packages are hosted on GitHub Packages.
@happilee-app:registry=https://npm.pkg.github.com

# Auth is intentionally NOT stored here (this file is committed to a public repo).
# Put a PAT (scope: read:packages) in a per-machine, UNTRACKED ~/.npmrc:
#
#   //npm.pkg.github.com/:_authToken=<YOUR_PAT>
#
# ~/.npmrc is always read by npm/bun, survives `git reset`, and never enters git.
# (Do not add an _authToken line here — a committed token, even ${NODE_AUTH_TOKEN},
#  breaks non-interactive installs when the env var is unset, e.g. deploy ssh.)
