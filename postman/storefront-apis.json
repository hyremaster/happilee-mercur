{
  "info": {
    "_postman_id": "adb67eca-ad40-4939-af7a-76d23562faa7",
    "name": "Happilee Commerce — Storefront API",
    "description": "All APIs required to browse products and place orders on a Happilee store.\n\nBase URL: https://api.happilee.io (set via {{base_url}} variable)\nStore URL pattern: https://commerce.happilee.io/store/{store_handle}\n\nVariables to configure:\n- base_url\n- publishable_key\n- seller_id\n- store_handle",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "26776924",
    "_collection_link": "https://go.postman.co/collection/26776924-adb67eca-ad40-4939-af7a-76d23562faa7?source=collection_link"
  },
  "item": [
    {
      "name": "0. Customer Auth",
      "item": [
        {
          "name": "Register Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('customer_token', json.token);",
                  "  console.log('Customer token saved.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"securepassword\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/customer/emailpass/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "customer",
                "emailpass",
                "register"
              ]
            },
            "description": "Register a new customer. Saves the returned JWT to {{customer_token}}."
          },
          "response": []
        },
        {
          "name": "Login Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('customer_token', json.token);",
                  "  console.log('Customer token saved.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"securepassword\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/customer/emailpass",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "customer",
                "emailpass"
              ]
            },
            "description": "Login existing customer. Saves the returned JWT to {{customer_token}}."
          },
          "response": []
        }
      ]
    },
    {
      "name": "1. Store / Seller",
      "item": [
        {
          "name": "List Sellers (by handle)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.sellers && json.sellers.length > 0) {",
                  "  pm.collectionVariables.set('seller_id', json.sellers[0].id);",
                  "  console.log('seller_id saved:', json.sellers[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-publishable-api-key",
                "value": "{{publishable_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/store/sellers?handle={{store_handle}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "store",
                "sellers"
              ],
              "query": [
                {
                  "key": "handle",
                  "value": "{{store_handle}}",
                  "description": "Store handle from URL path"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "disabled": true
                },
                {
                  "key": "offset",
                  "value": "0",
                  "disabled": true
                },
                {
                  "key": "q",
                  "value": "",
                  "description": "Full-text search",
                  "disabled": true
                }
              ]
            },
            "description": "Resolve a store handle to a seller profile. Saves first result to {{seller_id}}."
          },
          "response": []
        },
        {
          "name": "Get Seller by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-publishable-api-key",
                "value": "{{publishable_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/store/sellers/{{seller_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "store",
                "sellers",
                "{{seller_id}}"
              ]
            },
            "description": "Retrieve a single seller by ID."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Products",
      "item": [
        {
          "name": "List Products (by seller)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.products && json.products.length > 0) {",
                  "  const p = json.products[0];",
                  "  pm.collectionVariables.set('product_id', p.id);",
                  "  if (p.variants && p.variants.length > 0) {",
                  "    pm.collectionVariables.set('variant_id', p.variants[0].id);",
                  "    console.log('product_id saved:', p.id);",
                  "    console.log('variant_id saved:', p.variants[0].id);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-publishable-api-key",
                "value": "{{publishable_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/store/products?seller_id={{seller_id}}&fields=id,title,description,thumbnail,status,variants.id,variants.title,variants.sku,variants.prices,options",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "store",
                "products"
              ],
              "query": [
                {
                  "key": "seller_id",
                  "value": "{{seller_id}}",
                  "description": "Filter products to this seller"
                },
                {
                  "key": "fields",
                  "value": "id,title,description,thumbnail,status,variants.id,variants.title,variants.sku,variants.prices,options"
                },
                {
                  "key": "limit",
                  "value": "20",
                  "disabled": true
                },
                {
                  "key": "offset",
                  "value": "0",
                  "disabled": true
                },
                {
                  "key": "q",
                  "value": "",
                  "description": "Search term",
                  "disabled": true
                },
                {
                  "key": "category_id[]",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "collection_id[]",
                  "value": "",
                  "disabled": true
                }
              ]
            },
            "description": "List published products for a seller. Saves first product_id and variant_id."
          },
          "response": []
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-publishable-api-key",
                "value": "{{publishable_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/store/products/{{product_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "store",
                "products",
                "{{product_id}}"
