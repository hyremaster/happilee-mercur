    {
      "name": "8. Complete Cart (Place Order)",
      "item": [
        {
          "name": "Complete Cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.type === 'order_group' && json.order_group) {",
                  "  pm.collectionVariables.set('order_group_id', json.order_group.id);",
                  "  console.log('Order placed! order_group_id:', json.order_group.id);",
                  "} else if (json.type === 'cart') {",
