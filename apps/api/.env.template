DATABASE_URL=
REDIS_URL=

STORE_CORS=
ADMIN_CORS=
VENDOR_CORS=
AUTH_CORS=

JWT_SECRET=
COOKIE_SECRET=
# Vendor/admin login session lifetime in ms (session cookie, rolling). Default 1h.
SESSION_TTL_MS=3600000

MERCUR_VENDOR_URL=
HAPPILEE_SSO_SECRET=

# Area Sense external delivery-area service (wizard step 2)
# URL = base only (e.g. https://api.happilee.io); KEY = x-api-key value
AREASENSE_API_URL=
AREASENSE_API_KEY=

# WhatsApp Cloud API — delivers phone-login OTPs (/store/auth/phone/*)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Approved authentication template name + language
WHATSAPP_OTP_TEMPLATE=otp
WHATSAPP_TEMPLATE_LANG=en_US
# Meta Graph API version
WHATSAPP_API_VERSION=v21.0
# Set true only if the template has a copy-code URL button
WHATSAPP_OTP_BUTTON=false

# Phone-OTP auth tuning
# Salt for hashing OTP codes; falls back to JWT_SECRET if unset
PHONE_OTP_PEPPER=
# Domain for synthesized emails on phone-only customer accounts
PHONE_CUSTOMER_EMAIL_DOMAIN=phone.happilee.local

# Firebase phone (SMS) auth — backend verifies the client's Firebase ID token
# at /store/auth/firebase/verify. Service-account credentials (leave empty to
# disable the route). FIREBASE_PRIVATE_KEY keeps literal \n escapes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Public API base URL — used to auto-register per-seller Razorpay webhooks at
# <base>/hooks/payment/razorpay_razorpay. Leave empty to skip the API call
# (secret is still generated + stored for manual setup).
BACKEND_PUBLIC_URL=

# File storage (uploads). Set S3_BUCKET to use S3; leave empty for local disk.
S3_BUCKET=
S3_REGION=
# Public base URL objects are served from (bucket URL or CDN/CloudFront).
# Defaults to https://<bucket>.s3.<region>.amazonaws.com when empty.
S3_FILE_URL=
# Credentials: leave BOTH empty on EC2 to use the instance IAM role.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: custom endpoint (S3-compatible stores) + key prefix
S3_ENDPOINT=
S3_PREFIX=